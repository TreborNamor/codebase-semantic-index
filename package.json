{
  "name": "codebase-semantic-index",
  "displayName": "Codebase Semantic Index",
  "description": "Semantic search for your codebase using local AI embeddings. Find code by concept, not just keywords.",
  "version": "0.2.0",
  "publisher": "TreborNamor",
  "repository": {
    "type": "git",
    "url": "https://github.com/TreborNamor/codebase-semantic-index"
  },
  "bugs": {
    "url": "https://github.com/TreborNamor/codebase-semantic-index/issues"
  },
  "homepage": "https://github.com/TreborNamor/codebase-semantic-index#readme",
  "keywords": [
    "search",
    "semantic",
    "ai",
    "embeddings",
    "codebase"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codebase Semantic Index",
      "properties": {
        "codebaseSemanticIndex.exclude": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "description": "Additional indexing exclusion globs. Set a default generated/dependency exclusion to false to include it. Git metadata and index caches are always excluded."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebase-semantic-index",
          "title": "Codebase Semantic Index",
          "icon": "media/icon.svg"
        },
        {
          "id": "prompt-refinement",
          "title": "Prompt Refinement",
          "icon": "media/prompt-refinement.svg"
        }
      ]
    },
    "views": {
      "codebase-semantic-index": [
        {
          "type": "webview",
          "id": "codebase-semantic-index.panel",
          "name": "Codebase Semantic Index"
        },
        {
          "type": "webview",
          "id": "codebase-semantic-index.worker",
          "name": "Embedding Worker"
        }
      ],
      "prompt-refinement": [
        {
          "type": "webview",
          "id": "prompt-refinement.panel",
          "name": "Prompt Refinement"
        }
      ]
    },
    "commands": [
      {
        "command": "codebaseSemanticIndex.refinePrompt",
        "title": "Prompt Refinement: Open Composer",
        "icon": "$(wand)"
      },
      {
        "command": "codebaseSemanticIndex.openPanel",
        "title": "Codebase Semantic Index: Open Panel"
      },
      {
        "command": "codebaseSemanticIndex.buildIndex",
        "title": "Codebase Semantic Index: Build Index"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codebaseSemanticIndex.refinePrompt",
          "when": "view == prompt-refinement.panel",
          "group": "navigation"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "codebase_semantic_index_search",
        "toolReferenceName": "codebaseSemanticIndex",
        "canBeReferencedInPrompt": true,
        "tags": [
          "search",
          "codebase",
          "semantic"
        ],
        "displayName": "Codebase Semantic Index: Semantic Search",
        "modelDescription": "Search current workspace files by concept using local embeddings and exact identifier/path matching. Results are verified against current files and unsaved editor contents. Use for concept discovery; use local text/symbol search for known identifiers and read current source before editing. Supports workspace-relative path filtering. No remote repository or historical code is searched. If embeddings are unavailable, returns current-file lexical matches with an explicit status.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language or code description of what to find, e.g. 'cosine similarity calculation' or 'error handling for file not found'"
            },
            "maxResults": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5,
              "description": "Maximum number of results to return (default: 5, range: 1–20)"
            },
            "pathPrefix": {
              "type": "string",
              "description": "Optional workspace-relative file or directory, e.g. src/services. Applied within each workspace root."
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:web": "webpack --config webpack.smoke.config.js && node tests/runBrowserSmoke.cjs",
    "test:refiner-ui": "node tests/runPromptRefinerUi.cjs",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=."
  },
  "dependencies": {
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/webpack-env": "^1.18.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "^3.9.1",
    "@huggingface/transformers": "^4.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.0.0",
    "process": "^0.11.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.2",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4"
  }
}
